#:import get_color_from_hex kivy.utils.get_color_from_hex

# ===== 全局主题（绑定 app.theme.*，随主题切换自动重绘） =====

# 背景
<Screen>:
    canvas.before:
        Color:
            rgba: app.theme.bg
        Rectangle:
            pos: self.pos
            size: self.size

# 统一按钮
<Button>:
    background_normal: ""
    background_color: app.theme.button
    color: app.theme.button_text
    font_size: "17sp"
    bold: False
    disabled_color: app.theme.disabled_text
    canvas.before:
        Color:
            rgba: app.theme.button if self.state == "normal" else app.theme.button_pressed
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [10, 10, 10, 10]

# 主要操作按钮（绿色）
<PrimaryButton>:
    background_color: app.theme.primary
    color: app.theme.primary_text
    canvas.before:
        Color:
            rgba: app.theme.primary if self.state == "normal" else app.theme.primary_pressed
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [10, 10, 10, 10]

# 次要/危险按钮（红色）
<DangerButton>:
    background_color: app.theme.danger
    color: app.theme.danger_text
    canvas.before:
        Color:
            rgba: app.theme.danger if self.state == "normal" else app.theme.danger_pressed
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [10, 10, 10, 10]

# 标签
<Label>:
    color: app.theme.text
    font_size: "16sp"
    halign: "left"
    valign: "middle"

# 标题标签
<HeaderLabel@Label>:
    font_size: "24sp"
    bold: True
    halign: "center"

# 子标题
<SubLabel@Label>:
    font_size: "15sp"
    color: app.theme.text_muted
    halign: "center"
