#:import get_color_from_hex kivy.utils.get_color_from_hex

# ===== 全局主题（绑定 app.theme.*，随主题切换自动重绘） =====

# 背景
<Screen>:
    canvas.before:
        Color:
            rgba: app.theme.bg
        Rectangle:
            pos: self.pos
            size: self.size

# 统一按钮
<Button>:
    background_normal: ""
    background_down: ""
    background_disabled_normal: ""
    background_disabled_down: ""
    background_color: app.theme.button
    color: app.theme.button_text
    font_size: "17sp"
    bold: False
    disabled_color: app.theme.disabled_text

# 主要操作按钮（绿色）
<PrimaryButton>:
    background_normal: ""
    background_down: ""
    background_disabled_normal: ""
    background_disabled_down: ""
    background_color: app.theme.primary
    color: app.theme.primary_text

# 次要/危险按钮（红色）
<DangerButton>:
    background_normal: ""
    background_down: ""
    background_disabled_normal: ""
    background_disabled_down: ""
    background_color: app.theme.danger
    color: app.theme.danger_text

# 标签
<Label>:
    color: app.theme.text
    font_size: "16sp"
    halign: "left"
    valign: "middle"

# 标题标签
<HeaderLabel@Label>:
    font_size: "24sp"
    bold: True
    halign: "center"

# 子标题
<SubLabel@Label>:
    font_size: "15sp"
    color: app.theme.text_muted
    halign: "center"

# 弹窗：标题用主题文本色（浅/深主题均清晰），背景在 Python 端以主题色重画
<Popup>:
    title_color: app.theme.text
    title_size: "20sp"
    title_align: "left"
    separator_color: app.theme.card_border
