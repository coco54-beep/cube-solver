#:import get_color_from_hex kivy.utils.get_color_from_hex

# ===== 全局主题 =====
# 背景与文字
<Screen>:
    canvas.before:
        Color:
            rgba: get_color_from_hex("12141c")
        Rectangle:
            pos: self.pos
            size: self.size

# 统一按钮
<Button>:
    background_normal: ""
    background_color: get_color_from_hex("2b3a55")
    color: 1, 1, 1, 1
    font_size: "17sp"
    bold: False
    # 禁用态
    disabled_color: 0.5, 0.5, 0.55, 1
    canvas.before:
        Color:
            rgba: get_color_from_hex("2b3a55") if self.state == "normal" else get_color_from_hex("3d5175")
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [10, 10, 10, 10]

# 主要操作按钮（绿色）
<PrimaryButton>:
    background_color: get_color_from_hex("2e7d4f")
    canvas.before:
        Color:
            rgba: get_color_from_hex("2e7d4f") if self.state == "normal" else get_color_from_hex("3d9b62")
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [10, 10, 10, 10]

# 次要/危险按钮（红色）
<DangerButton>:
    background_color: get_color_from_hex("7d3b3b")
    canvas.before:
        Color:
            rgba: get_color_from_hex("7d3b3b") if self.state == "normal" else get_color_from_hex("9b5050")
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [10, 10, 10, 10]

# 标签
<Label>:
    color: 1, 1, 1, 1
    font_size: "16sp"
    halign: "left"
    valign: "middle"

# 标题标签
<HeaderLabel@Label>:
    font_size: "24sp"
    bold: True
    halign: "center"

# 子标题
<SubLabel@Label>:
    font_size: "15sp"
    color: 0.75, 0.78, 0.85, 1
    halign: "center"
